# Local environment (loaded by `agentcore dev`; never commit secrets)
.env.local
.env*.local

# Python
__pycache__/
*.py[cod]
.venv/

# Node
node_modules/

# AgentCore CLI state (ignore local scratch like traces/logs, but commit the
# deployed-state binding so a target's stack + credential ARNs are shared)
agentcore/.cli/*
!agentcore/.cli/deployed-state.json

# AgentCore build cache (CodeZip dependency staging)
agentcore/.cache/

# CDK
agentcore/cdk/cdk.out/

# AgentCore runtime config (holds the API key in envVars) — never commit
agentcore/agentcore.json

# macOS
.DS_Store
